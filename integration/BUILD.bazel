#
# The example consumer. It uses only the public API of hdlf_rules_fab, as a
# user of the published module would. The e2e board's fab packages arrive
# with fab_package (milestone M3).
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@hdlf_rules_fab//fab:defs.bzl", "RULES_FAB_API_VERSION")

# hdlf_rules_kicad resolves through its archive_override, and its public API
# loads and builds in a module that depends on hdlf_rules_fab (issue #7).
build_test(
    name = "rules_kicad_builds",
    size = "small",
    targets = ["@hdlf_rules_kicad//kicad:defs"],
)

# The public packages load and build: the rules, and the root package
# with the --@hdlf_rules_fab//:tools flag that every user's build reads.
build_test(
    name = "public_api_builds",
    size = "small",
    targets = [
        "@hdlf_rules_fab//:tools",
        "@hdlf_rules_fab//:tools_prebuilt",
        "@hdlf_rules_fab//:tools_source",
        "@hdlf_rules_fab//fab:defs",
    ],
)

# The module resolved here is the one this consumer was written for.
write_file(
    name = "api_version",
    out = "api_version.txt",
    content = [
        RULES_FAB_API_VERSION,
        "",
    ],
)

diff_test(
    name = "api_version_test",
    size = "small",
    file1 = ":api_version",
    file2 = "expected_api_version.txt",
)
