#
# The e2e board's JLCPCB and PCBWay packages, from rules_kicad's Gerbers,
# drill file, BOM and positions (issues #9, #10): what a user of both
# modules writes. The same bytes in two configurations.
load("@rules_fab//fab:defs.bzl", "determinism_test", "fab_package", "fab_package_test")
load("@rules_kicad//kicad:defs.bzl", "kicad_bom", "kicad_drill", "kicad_gerbers", "kicad_pos")

kicad_gerbers(
    name = "gerbers",
    pcb = "//e2e:pcb",
)

kicad_drill(
    name = "drill",
    pcb = "//e2e:pcb",
)

kicad_bom(
    name = "bom",
    schematic = "//e2e:sch",
)

kicad_pos(
    name = "pos",
    pcb = "//e2e:pcb",
)

fab_package(
    name = "jlcpcb",
    board_name = "main",
    bom = ":bom",
    drill = ":drill",
    gerbers = ":gerbers",
    pos = ":pos",
    vendor = "jlcpcb",
)

determinism_test(
    name = "jlcpcb_determinism_test",
    size = "small",
    target = ":jlcpcb",
)

fab_package(
    name = "pcbway",
    board_name = "main",
    bom = ":bom",
    drill = ":drill",
    gerbers = ":gerbers",
    pos = ":pos",
    vendor = "pcbway",
)

determinism_test(
    name = "pcbway_determinism_test",
    size = "small",
    target = ":pcbway",
)

# M3's exit: the e2e board gives two vendor ZIPs that pass (issue #11).
# One line per ZIP: name, package, vendor. Another board is one more line.
[
    fab_package_test(
        name = name,
        size = "small",
        package = package,
        vendor = vendor,
    )
    for name, package, vendor in [
        ("jlcpcb_test", ":jlcpcb", "jlcpcb"),
        ("pcbway_test", ":pcbway", "pcbway"),
    ]
]
