# SPDX-License-Identifier: Apache-2.0
#
# The Bazel Central Registry presubmit builds this module against the
# published hdlf_rules_fab archive. `.bcr/presubmit.yml` names it by the
# `module_path: "integration"` key.
#
# The version below and the override are both replaced by the registry
# presubmit, which points the dependency at the release being published.
# Locally the override makes the module resolve to the parent directory, so
# `cd integration && bazel test //...` exercises the working tree.
module(
    name = "hdlf_rules_fab_integration",
    version = "0.0.0",
)

bazel_dep(name = "hdlf_rules_fab", version = "0.0.0")
local_path_override(
    module_name = "hdlf_rules_fab",
    path = "..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

# hdlf_rules_fab's own override does not reach this module: overrides apply in
# the root module only. The same pinned commit of hdlf_rules_kicad (issue #7).
bazel_dep(name = "hdlf_rules_kicad", version = "0.0.0")

# The same pin as MODULE.bazel and README.md; change all three together.
archive_override(
    module_name = "hdlf_rules_kicad",
    integrity = "sha256-46jre2ndNDzCLSCl8vCHchOngJMCRWuO2zdDKuFB/Ew=",
    strip_prefix = "bazel_rules_kicad-9acaa9cbdcdf4b99a1e9b0ee0af79f1fc682f414",
    urls = ["https://github.com/filmil/bazel_rules_kicad/archive/9acaa9cbdcdf4b99a1e9b0ee0af79f1fc682f414.tar.gz"],
)

# KiCad's standard symbol and footprint libraries, for the e2e design.
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
use_repo(kicad, "kicad_libs")
