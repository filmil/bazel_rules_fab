#
# The e2e board passes KiCad's design rules check with JLCPCB's rules, for
# two layers and 1 oz copper (issue #8). hdlf_rules_kicad's canary also checks
# that KiCad read the rule file.
load("@hdlf_rules_fab//fab:defs.bzl", "fab_rules")
load("@hdlf_rules_kicad//kicad:defs.bzl", "kicad_drc_test", "kicad_pcb")

fab_rules(
    name = "jlcpcb_rules",
    stackup = "2L-1oz",
    vendor = "jlcpcb",
)

kicad_pcb(
    name = "pcb_jlcpcb",
    board = "//e2e:main.kicad_pcb",
    design_rules = ":jlcpcb_rules",
    schematic = "//e2e:sch",
)

kicad_drc_test(
    name = "jlcpcb_drc_test",
    size = "small",
    pcb = ":pcb_jlcpcb",
)
