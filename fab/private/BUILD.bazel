load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":assembly_limits_test.bzl", "limits_test", "rungs_test")

bzl_library(
    name = "private",
    srcs = [
        "assembly.bzl",
        "determinism.bzl",
        "fab_rules.bzl",
        "package.bzl",
        "package_test.bzl",
        "run_tool.bzl",
        "swap_test.bzl",
        "swatch.bzl",
        "toolchains.bzl",
    ],
    visibility = ["//fab:__subpackages__"],
    deps = ["@hdlf_rules_kicad//kicad:defs"],
)

# A setting that changes nothing but the configuration. determinism_test
# builds its target once with "a" and once with "b", so every action runs
# twice, with different output paths.
string_flag(
    name = "determinism_salt",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# The BUILD file of the kicad-druid archive (MODULE.bazel).
exports_files(["kicad_druid.BUILD"])

# The assembly swatch's vendor limits on their own, with a made-up coarse
# vendor for the pitch limit that neither real vendor reaches. Here, as
# assembly.bzl loads only from //fab.
limits_test(
    name = "assembly_limits_test",
    size = "small",
)

rungs_test(
    name = "assembly_rungs_test",
    size = "small",
)
