module(
    name = "hdlf_rules_fab",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# This module's helpers (the launcher, the stub and checker of swap_test)
# and its development tools are Go, built from source. They are pure Go,
# so a user of the module needs no C++ toolchain for them; rules_go brings
# its own Go SDK.
bazel_dep(name = "rules_go", version = "0.64.2")

# The fab rules read hdlf_rules_kicad's outputs (Gerbers, drill, position and
# BOM files), and KiCad runs only through hdlf_rules_kicad's toolchain.
# hdlf_rules_kicad is in no registry yet, so this pins a commit of it (issue #7),
# as GitHub's archive of that commit, checked by its hash: git_override
# would need git on the host, and the CI image has none.
# Remove the override once hdlf_rules_kicad 0.1.0 is in the BCR; until then a
# release waits: Tag and Release's bcr_ready job requires that every
# dependency resolves from the BCR alone.
bazel_dep(name = "hdlf_rules_kicad", version = "0.0.0")

# The same pin is in integration/MODULE.bazel and README.md; change all
# three together.
archive_override(
    module_name = "hdlf_rules_kicad",
    integrity = "sha256-46jre2ndNDzCLSCl8vCHchOngJMCRWuO2zdDKuFB/Ew=",
    strip_prefix = "bazel_rules_kicad-9acaa9cbdcdf4b99a1e9b0ee0af79f1fc682f414",
    urls = ["https://github.com/filmil/bazel_rules_kicad/archive/9acaa9cbdcdf4b99a1e9b0ee0af79f1fc682f414.tar.gz"],
)

# KiCad's symbol libraries, which the assembly swatch's schematic uses
# (issue #32): the same pinned libraries as hdlf_rules_kicad's rules.
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
use_repo(kicad, "kicad_libs")

# kicad-druid 1.2.0: KiCad design rules for JLCPCB, PCBWay and a generic
# fab (issue #8, MIT). Its releases have no assets, so this is the tag's
# source archive, checked by its sha256.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "kicad_druid",
    build_file = "//fab/private:kicad_druid.BUILD",
    sha256 = "85b07296d10beb91a96b12870b5cab83894ac2cf6b035b84df90e0f1a9516401",
    strip_prefix = "kicad-druid-1.2.0",
    # This repository's mirror first (tools/mirror), then GitHub's archive.
    urls = [
        "https://github.com/filmil/bazel_rules_fab/releases/download/mirror-kicad-druid-1.2.0/kicad-druid-1.2.0.tar.gz",
        "https://github.com/Cimos/kicad-druid/archive/refs/tags/v1.2.0.tar.gz",
    ],
)

# The helpers toolchain, which every rule that runs a tool needs.
register_toolchains(
    "//fab/toolchains:helpers",
    # Last, so it is picked only off Linux x86_64 (spec P1).
    "//fab/toolchains:unsupported",
)

# The demonstration tools of the swap test template
# (fab/private/swapdemo) and of determinism_test's own tests
# (fab/private/detdemo).
register_toolchains(
    "//fab/private/swapdemo:all",
    "//fab/private/detdemo:all",
    dev_dependency = True,
)

# stardoc renders through Java and protobuf. Protobuf 34.1 and later bring a
# prebuilt protoc (enabled in .bazelrc), so the documentation build compiles
# no C++ and needs no C++ toolchain. Dev only: it raises the version stardoc
# would otherwise pick.
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)

# Bazel's Java launcher (used by stardoc) asks for a C++ toolchain even when
# nothing compiles C++, and .bazelrc turns off host toolchain detection. zig's
# toolchain is one self-contained binary, so it reads nothing from the host.
# Dev only: a user of the module brings its own C++ toolchain if it needs one.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    dev_dependency = True,
)

bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
