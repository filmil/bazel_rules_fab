#
# fab_package (issues #9, #10) on fixture files in the shape of hdlf_rules_kicad's
# outputs (board/): the ZIP's entries and CSVs, a rotation correction, the
# same bytes in two configurations.
load("@rules_go//go:def.bzl", "go_test")
load("//fab:defs.bzl", "determinism_test", "fab_package")

package(default_visibility = ["//tests/fab_package_test:__pkg__"])

exports_files(glob(["board/**"]))

filegroup(
    name = "gerbers",
    srcs = glob(["board/gerbers/*"]),
)

# The fixture board without its bottom copper: fab_package_test's
# known-bad ZIP.
filegroup(
    name = "gerbers_no_b_cu",
    srcs = glob(
        ["board/gerbers/*"],
        exclude = ["board/gerbers/main-B_Cu.gbl"],
    ),
)

fab_package(
    name = "jlcpcb",
    board_name = "main",
    bom = "board/bom.csv",
    drill = "board/drill/main.drl",
    gerbers = ":gerbers",
    pos = "board/pos.csv",
    vendor = "jlcpcb",
)

# The same, with JLCPCB's 0603 LED turned by 180 degrees.
fab_package(
    name = "jlcpcb_rotated",
    board_name = "main",
    bom = "board/bom.csv",
    drill = "board/drill/main.drl",
    gerbers = ":gerbers",
    pos = "board/pos.csv",
    rotations = {"LED_0603_.*": "180"},
    vendor = "jlcpcb",
)

fab_package(
    name = "pcbway",
    board_name = "main",
    bom = "board/bom.csv",
    drill = "board/drill/main.drl",
    gerbers = ":gerbers",
    pos = "board/pos.csv",
    vendor = "pcbway",
)

go_test(
    name = "zip_test",
    size = "small",
    srcs = ["zip_test.go"],
    args = [
        "--zip=$(rlocationpath :jlcpcb)",
        "--rotated=$(rlocationpath :jlcpcb_rotated)",
        "--pcbway=$(rlocationpath :pcbway)",
    ],
    data = [
        ":jlcpcb",
        ":jlcpcb_rotated",
        ":pcbway",
    ],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)

determinism_test(
    name = "jlcpcb_determinism_test",
    size = "small",
    target = ":jlcpcb",
)

determinism_test(
    name = "pcbway_determinism_test",
    size = "small",
    target = ":pcbway",
)
