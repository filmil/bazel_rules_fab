# fab_swatch (issues #24, #35): each vendor's capability swatch, for every
# stackup, passes DRC with its own rules (the canary shows they loaded); each known-bad swatch, one
# feature under the minimum, fails on that feature's rule and no other;
# the files repeat byte for byte and make Gerbers and drill files, which
# //tests/fab_package_test packages for each vendor. (No swap_test: the
# generator is this module's own Go, built from source in the helpers
# toolchain, like fab_package's packager.)
load("@hdlf_rules_kicad//kicad:defs.bzl", "kicad_drc_test", "kicad_drill", "kicad_gerbers")
load("//fab:defs.bzl", "FAB_STACKUPS", "SWATCH_BELOW", "determinism_test", "fab_swatch")

# The swatches: one line per vendor and stackup.
[
    [
        fab_swatch(
            name = name,
            stackup = stackup,
            vendor = vendor,
        ),
        kicad_drc_test(
            name = name + "_drc_test",
            size = "small",
            pcb = ":" + name,
        ),
        determinism_test(
            name = name + "_determinism_test",
            size = "small",
            target = ":" + name + "_files",
        ),
        kicad_gerbers(
            name = name + "_gerbers",
            pcb = ":" + name,
            visibility = ["//tests/fab_package_test:__pkg__"],
        ),
        kicad_drill(
            name = name + "_drill",
            pcb = ":" + name,
            visibility = ["//tests/fab_package_test:__pkg__"],
        ),
    ]
    for name, vendor, stackup in [
        (
            "%s_%s" % (
                vendor,
                stackup.replace("-", "_"),
            ),
            vendor,
            stackup,
        )
        for vendor in [
            "generic",
            "jlcpcb",
            "pcbway",
        ]
        for stackup in FAB_STACKUPS
    ]
]

# Known bad (spec T3): each feature a step under the vendor's minimum.
[
    [
        fab_swatch(
            name = "%s_below_%s" % (vendor, feature),
            below = feature,
            stackup = "2L-1oz",
            vendor = vendor,
        ),
        kicad_drc_test(
            name = "%s_below_%s_drc_test" % (vendor, feature),
            size = "small",
            expect = violation,
            pcb = ":%s_below_%s" % (vendor, feature),
        ),
    ]
    for vendor in [
        "generic",
        "jlcpcb",
        "pcbway",
    ]
    for feature, violation in SWATCH_BELOW.items()
    if not feature.startswith("inner_")
]

# Known bad on an inner layer (issue #35): In1.Cu's narrowest track, or
# its smallest gap, a step under the vendor's inner minimum, on each
# stackup with inner layers.
[
    [
        fab_swatch(
            name = "%s_%s_below_%s" % (
                vendor,
                stackup.replace("-", "_"),
                feature,
            ),
            below = feature,
            stackup = stackup,
            vendor = vendor,
        ),
        kicad_drc_test(
            name = "%s_%s_below_%s_drc_test" % (
                vendor,
                stackup.replace("-", "_"),
                feature,
            ),
            size = "small",
            expect = SWATCH_BELOW[feature],
            pcb = ":%s_%s_below_%s" % (
                vendor,
                stackup.replace("-", "_"),
                feature,
            ),
        ),
    ]
    for vendor in [
        "generic",
        "jlcpcb",
        "pcbway",
    ]
    for stackup in FAB_STACKUPS
    if not stackup.startswith("2L")
    for feature in [
        "inner_track_spacing",
        "inner_track_width",
    ]
]
