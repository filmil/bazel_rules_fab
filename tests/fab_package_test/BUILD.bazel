# fab_package_test (issue #11): the fixture board's ZIPs pass for their
# vendor, and known-bad ZIPs fail (T3): one missing a layer, and one
# checked against the other vendor's columns and file names.
load("//fab:defs.bzl", "fab_package", "fab_package_test")
load("//tests/fab_rules:fails_test.bzl", "fails_test")

# One line per good ZIP: name, package, vendor.
[
    fab_package_test(
        name = name,
        size = "small",
        package = package,
        vendor = vendor,
    )
    for name, package, vendor in [
        ("jlcpcb_test", "//tests/fab_package:jlcpcb", "jlcpcb"),
        ("pcbway_test", "//tests/fab_package:pcbway", "pcbway"),
    ]
]

fab_package(
    name = "no_b_cu",
    board_name = "main",
    bom = "//tests/fab_package:board/bom.csv",
    drill = "//tests/fab_package:board/drill/main.drl",
    gerbers = "//tests/fab_package:gerbers_no_b_cu",
    pos = "//tests/fab_package:board/pos.csv",
    vendor = "jlcpcb",
)

fab_package_test(
    name = "missing_layer_test",
    size = "small",
    package = ":no_b_cu",
    vendor = "jlcpcb",
    want_error = "no bottom copper (B_Cu) (*.gbl)",
)

# A JLCPCB ZIP is not a PCBWay one: the BOM's columns differ.
fab_package_test(
    name = "wrong_columns_test",
    size = "small",
    package = "//tests/fab_package:jlcpcb",
    vendor = "pcbway",
    want_error = "main_bom.csv: columns",
)

# ...and the placement list's name.
fab_package_test(
    name = "wrong_names_test",
    size = "small",
    package = "//tests/fab_package:jlcpcb",
    vendor = "pcbway",
    want_error = "no placement list (*_centroid.csv)",
)

# A bare board: the fixture's Gerbers and drill file, no BOM or placement
# list, for each vendor.
[
    [
        fab_package(
            name = "bare_" + vendor,
            board_name = "main",
            drill = "//tests/fab_package:board/drill/main.drl",
            gerbers = "//tests/fab_package:gerbers",
            vendor = vendor,
        ),
        fab_package_test(
            name = "bare_%s_test" % vendor,
            size = "small",
            bare = True,
            package = ":bare_" + vendor,
            vendor = vendor,
        ),
    ]
    for vendor in [
        "jlcpcb",
        "pcbway",
    ]
]

# Known bad: a bare ZIP checked as one with parts lacks both lists...
fab_package_test(
    name = "bare_as_full_test",
    size = "small",
    package = ":bare_jlcpcb",
    vendor = "jlcpcb",
    want_error = "no BOM (*_bom.csv)",
)

# ...and a ZIP with parts checked as bare has lists it should not.
fab_package_test(
    name = "full_as_bare_test",
    size = "small",
    bare = True,
    package = "//tests/fab_package:jlcpcb",
    vendor = "jlcpcb",
    want_error = "main_bom.csv: a bare board's ZIP has no BOM or placement list",
)

# Each vendor's capability swatch (issue #31), for every stackup, packaged
# as a bare board: one line per vendor, so a vendor without a swatch shows.
[
    [
        fab_package(
            name = "swatch_%s_%s" % (vendor, stackup),
            drill = "//tests/swatch:%s_%s_drill" % (vendor, stackup),
            gerbers = "//tests/swatch:%s_%s_gerbers" % (vendor, stackup),
            vendor = vendor,
        ),
        fab_package_test(
            name = "swatch_%s_%s_test" % (vendor, stackup),
            size = "small",
            bare = True,
            package = ":swatch_%s_%s" % (vendor, stackup),
            vendor = vendor,
        ),
    ]
    for vendor in [
        "jlcpcb",
        "pcbway",
    ]
    for stackup in [
        "2L_1oz",
        "4L_1oz",
        "4L_2oz",
        "6L_1oz",
    ]
]

# A BOM without positions, positions without a BOM, and rotations without
# either, fail analysis.
fab_package(
    name = "bom_only",
    bom = "//tests/fab_package:board/bom.csv",
    drill = "//tests/fab_package:board/drill/main.drl",
    gerbers = "//tests/fab_package:gerbers",
    tags = ["manual"],
    vendor = "jlcpcb",
)

fails_test(
    name = "bom_only_test",
    size = "small",
    message = "bom goes with pos: give both, or neither for a bare board",
    target_under_test = ":bom_only",
)

fab_package(
    name = "pos_only",
    drill = "//tests/fab_package:board/drill/main.drl",
    gerbers = "//tests/fab_package:gerbers",
    pos = "//tests/fab_package:board/pos.csv",
    tags = ["manual"],
    vendor = "jlcpcb",
)

fails_test(
    name = "pos_only_test",
    size = "small",
    message = "bom goes with pos: give both, or neither for a bare board",
    target_under_test = ":pos_only",
)

fab_package(
    name = "bare_rotated",
    drill = "//tests/fab_package:board/drill/main.drl",
    gerbers = "//tests/fab_package:gerbers",
    rotations = {".*": "90"},
    tags = ["manual"],
    vendor = "jlcpcb",
)

fails_test(
    name = "bare_rotated_test",
    size = "small",
    message = "a bare board has none",
    target_under_test = ":bare_rotated",
)
